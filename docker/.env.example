# PostgreSQL
POSTGRES_DB=idv_bursiyer
POSTGRES_USER=idv
POSTGRES_PASSWORD=idv_dev
POSTGRES_PORT=5434

# Backend
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=docker
CORS_ORIGINS=http://localhost:3000

# Frontend
FRONTEND_PORT=3000

# Keycloak (port 8082 — psikohekim Keycloak 8080 ile çakışmaz)
KEYCLOAK_PORT=8082
KEYCLOAK_HOSTNAME=http://localhost:8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev
KEYCLOAK_ISSUER_URI=http://localhost:8082/realms/idv-bursiyer

# Frontend → Keycloak (build args)
VITE_KEYCLOAK_URL=http://localhost:8082
VITE_KEYCLOAK_REALM=idv-bursiyer
VITE_KEYCLOAK_CLIENT=idv-bursiyer-frontend

# Uygulama
SCHOLARSHIP_AMOUNT=3000
INTERVIEW_PASS_THRESHOLD=80
